<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD MAPPER 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lblog.dao.AdminRsaKeyDao">
    <select id="getAdminRsaKeyById" parameterType="java.lang.Long" resultType="com.lblog.domain.AdminRsaKey">
        SELECT
            *
        FROM
            l_admin_rsa_key
        WHERE
            id = #{id}
    </select>

    <select id="getAdminRsaKeyByAdminId" parameterType="java.lang.Long" resultType="com.lblog.domain.AdminRsaKey">
        SELECT
            *
        FROM
            l_admin_rsa_key
        WHERE
            admin_id = #{adminId}
    </select>

    <insert id="addAdminRsaKey" parameterType="com.lblog.domain.AdminRsaKey" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO
            l_admin_rsa_key (
                admin_id,
                public_key_base64,
                private_key_base64,
                add_time
            ) VALUES (
                #{adminId},
                #{publicKeyBase64},
                #{privateKeyBase64},
                #{addTime}
            )
    </insert>

    <delete id="deleteAdminRsaKey">
        DELETE FROM
            l_admin_rsa_key
        WHERE
            admin_id IN
        <foreach collection="adminId" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </delete>
</mapper>