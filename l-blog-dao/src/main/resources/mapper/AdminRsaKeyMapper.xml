<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD MAPPER 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lblog.dao.AdminRsaKeyDao">
    <select id="getAdminRsaKeyById" parameterType="java.lang.Long" resultType="com.lblog.domain.AdminRsaKey">
        SELECT
            *
        FROM
            l_admin_rsa_key
        WHERE
            id = #{id}
    </select>

    <select id="getAdminRsaKeyByAdminId" parameterType="java.lang.Long" resultType="com.lblog.domain.AdminRsaKey">
        SELECT
            *
        FROM
            l_admin_rsa_key
        WHERE
            admin_id = #{adminId}
    </select>
</mapper>