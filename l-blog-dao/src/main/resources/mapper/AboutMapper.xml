<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD MAPPER 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lblog.dao.AboutDao">
    <update id="editAbout" parameterType="com.lblog.domain.About">
        UPDATE
            l_about
        <set>
            <if test="content != null">
                content = #{content},
            </if>
            <if test="status != null and status != 0">
                status = #{status},
            </if>
            edit_time = #{editTime}
        </set>
        WHERE
            id = #{id}
    </update>

    <select id="getAboutDetail" parameterType="java.lang.Long" resultType="com.lblog.domain.About">
        SELECT
            *
        FROM
            l_about
        WHERE
            id = #{id}
    </select>
</mapper>