<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD MAPPER 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lblog.dao.UserDao">
    <select id="getUserId" parameterType="java.lang.String" resultType="java.lang.Long">
        SELECT
            id
        FROM
            l_user
        WHERE
            name = #{name}
    </select>

    <insert id="addUser" parameterType="com.lblog.domain.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO
            l_user (
                name,
                password,
                add_time
            ) VALUES (
                #{name},
                #{password},
                #{addTime}
            )
    </insert>
    
    <update id="editUser" parameterType="com.lblog.domain.User">
        UPDATE
            l_user
        <set>
            <if test="status != null and status != 0">
                status = #{status}
            </if>
            edit_time = #{editTime}
        </set>
        WHERE
            user_id = #{userId}
    </update>

    <select id="getUserList" resultType="com.lblog.domain.User">
        SELECT
            *
        FROM
            l_user
        ORDER BY
            id ASC
        LIMIT
            #{startNum}, #{size}
    </select>

    <select id="getUserDetail" parameterType="java.lang.Long" resultType="com.lblog.domain.User">
        SELECT
            *
        FROM
            l_user
        WHERE
            user_id = #{userId}
    </select>
    
    <select id="getUserTotal" resultType="java.lang.Integer">
        SELECT
            COUNT(id)
        FROM
            l_user
        WHERE
            status = 1
    </select>
</mapper>