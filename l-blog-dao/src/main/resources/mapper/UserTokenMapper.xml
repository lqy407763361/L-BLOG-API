<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD MAPPER 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lblog.dao.UserTokenDao">
    <insert id="addUserToken" parameterType="com.lblog.domain.UserToken" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO
            l_user (
                user_id,
                token,
                add_time
            ) VALUES (
                #{userId},
                #{token},
                #{addTime}
            )
    </insert>

    <delete id="deleteUserToken">
        DELETE FROM
            l_user_token
        WHERE
            user_id = #{userId}
    </delete>
</mapper>